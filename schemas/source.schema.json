{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "AI Kit content manifest",
  "description": "aikit.toml at the root of a content tree (the kit's own content, a Core source later).",
  "type": "object",
  "required": [
    "schema",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "min_engine": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Oldest AI Kit that can apply this content."
    },
    "kind": {
      "enum": [
        "core",
        "team"
      ]
    }
  }
}
