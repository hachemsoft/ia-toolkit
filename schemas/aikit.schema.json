{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aikit.schema.json",
  "title": "AI Kit ~/.ai-kit/aikit.toml",
  "description": "The person's AI Kit 2 settings (docs/configuration.md). Unknown keys are reported and ignored.",
  "type": "object",
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "user": {
      "type": "object",
      "properties": {
        "extra_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Add skills to the selection."
        },
        "disabled_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Remove skills to the selection."
        },
        "extra_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Add commands to the selection."
        },
        "disabled_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Remove commands to the selection."
        },
        "extra_agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Add agents to the selection."
        },
        "disabled_agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Remove agents to the selection."
        },
        "skill_prefix": {
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9-]{0,19})?$"
        },
        "active_team": {
          "type": "string",
          "description": "The active Team (ai-kit team use writes it), or none."
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "true turns a guardrail or hook on, false off."
    },
    "mcp": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Servers of the organization to turn on."
        },
        "denied": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Servers to turn off."
        }
      }
    },
    "frictions": {
      "type": "object",
      "properties": {
        "capture": {
          "enum": [
            "propose",
            "auto",
            "off"
          ]
        },
        "publication": {
          "enum": [
            "approval",
            "disabled"
          ],
          "description": "disabled: your frictions stay local."
        }
      }
    },
    "core": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "URL of your Core repository (IT's enterprise.core wins)."
        }
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "allow_prerelease": {
          "type": "boolean"
        }
      }
    },
    "teams": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          }
        },
        "required": [
          "repo"
        ]
      }
    }
  }
}
