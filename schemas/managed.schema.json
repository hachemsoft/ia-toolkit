{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "managed.schema.json",
  "title": "AI Kit managed.toml",
  "description": "Settings IT imposes on AI Kit (docs/configuration.md). Closed: an unknown key refuses the file.",
  "type": "object",
  "required": [
    "managed_schema"
  ],
  "additionalProperties": false,
  "properties": {
    "managed_schema": {
      "const": 1
    },
    "hooks": {
      "type": "object",
      "description": "locked: guardrails nobody can turn off; <guardrail> = true or false for everyone.",
      "properties": {
        "locked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Guardrails kept on."
        }
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_stdio": {
          "type": "boolean",
          "description": "false: no local (stdio) MCP server is installed."
        },
        "denied": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Servers never installed: a name, a URL prefix (https://host/path) or an executable."
        },
        "allowed_http": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "description": "Exact identities of the remote servers allowed."
        },
        "allowed_stdio": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "description": "Exact identities of the local servers allowed (ai-kit status --verbose shows them)."
        }
      }
    },
    "frictions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture": {
          "enum": [
            "propose",
            "auto",
            "off"
          ]
        },
        "publication": {
          "enum": [
            "approval",
            "auto",
            "disabled"
          ],
          "description": "approval (default): the person sends from a terminal."
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Local frictions older than this are purged (default 30)."
        },
        "tracker": {
          "type": "object",
          "description": "The team's tracker frictions go to: kind (gitlab|github), project (group/project), host, labels, sources.",
          "properties": {
            "kind": {
              "enum": [
                "gitlab",
                "github"
              ]
            },
            "project": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "enum": [
                  "person",
                  "agent",
                  "doctor"
                ]
              }
            }
          }
        }
      }
    },
    "enterprise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "string",
          "description": "URL of the Core repository every workstation uses."
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Git hosts accepted, exactly."
        },
        "allowed_groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Path prefixes accepted (a full group: ai-toolkit/)."
        },
        "allowed_schemes": {
          "type": "array",
          "items": {
            "enum": [
              "https",
              "ssh"
            ]
          }
        },
        "allow_prerelease": {
          "type": "boolean"
        },
        "revoked": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "description": "Commits never activated, even by rollback."
        },
        "signers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SSH public keys whose signature a tag must carry (optional)."
        }
      }
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_unknown": {
          "type": "boolean"
        }
      }
    }
  }
}
